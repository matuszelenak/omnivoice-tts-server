# ── Model / GPU ─────────────────────────────────────────────────────────────
# Run on the GPU the ASR service is NOT using (parakeet uses the other one).
GPU=0
DEVICE=cuda:0
DTYPE=auto                    # auto | float16 | bfloat16 | float32 (auto=bf16 on Ampere+)

# ── Decoding quality / latency ──────────────────────────────────────────────
NUM_STEPS=16                  # diffusion steps per chunk (cost is linear)
FIRST_CHUNK_STEPS=12          # steps for the first streamed chunk
GUIDANCE_SCALE=2.0            # 0 = faster, measurably worse for Slovak
MAX_INPUT_CHARS=4000          # reject larger requests with 413
MAX_CHUNK_CHARS=320           # hard cap per model call

# ── CUDA graphs ─────────────────────────────────────────────────────────────
TORCH_COMPILE=true           # compile the backbone with inductor (1.65x measured)
COMPILE_MODE=default          # default | reduce-overhead | max-autotune
CUDA_GRAPHS=false             # extra 6% on an *uncompiled* model; redundant with compile
GRAPH_BUCKET=32               # pad sequence length to this multiple
GRAPH_MAX=12                   # max captured lengths (~160 MB each)
GRAPH_MIN_FREE_MB=4096        # refuse to capture below this much free VRAM

# ── Admission control ───────────────────────────────────────────────────────
MAX_QUEUE_JOBS=48             # queued chunks before 503 + Retry-After
MAX_PENDING_AUDIO_S=180       # queued audio seconds before 503
QUEUE_TIMEOUT_S=120
FIRST_CHUNK_BURST=4
MAX_STREAM_SESSIONS=64
STREAM_MAX_PENDING_S=180      # unsynthesised text a WS client may buffer

# ── Voices ──────────────────────────────────────────────────────────────────
VOICE_SAMPLES_DIR=/app/voices
MAX_REF_SECONDS=8             # references are cut to this length
MIN_REF_SECONDS=2
ASR_URL=http://host.docker.internal:9000   # sibling parakeet-asr-server
ASR_TIMEOUT_S=60

# ── Text sanitisation (optional) ────────────────────────────────────────────
# An OpenAI-compatible LLM that rewrites digits, abbreviations and symbols into
# spoken words before synthesis (OmniVoice mispronounces "3 kg", "napr.", "$50").
# Leave SANITIZE_LLM_BASE_URL empty to disable. Runs per sentence, so streaming
# still starts quickly; failures fall back to the raw text.
SANITIZE_LLM_BASE_URL=
SANITIZE_LLM_API_KEY=none
SANITIZE_LLM_MODEL=gpt-4o-mini
SANITIZE_LLM_TIMEOUT_S=10

# ── Paths / observability ───────────────────────────────────────────────────
HF_HOME=./server/models
LOGFIRE_TOKEN=
LOG_LEVEL=info
METRICS_ENABLED=true
CORS_ORIGINS=*
